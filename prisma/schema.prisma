// ==========================================================
// Prisma Schema — Online Grocery Web App
// Referensi: ERD_Online_Grocery_Web_App.md
// Catatan: nama tabel & kolom di-map ke snake_case (@@map / @map)
// supaya konsisten dengan dokumen ERD yang sudah didiskusikan.
// Ganti "provider" di datasource sesuai kesepakatan tim (default: postgresql)
// ==========================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------
// ENUMS
// ---------------------------

enum Role {
  customer
  store_admin
  super_admin
}

enum AuthProvider {
  email
  google
  facebook
}

enum TokenType {
  email_verification
  password_reset
}

enum StockJournalType {
  in
  out
}

enum StockReferenceType {
  order
  manual_adjustment
  order_cancel
  store_transfer
}

enum DiscountType {
  direct
  min_purchase
  buy1get1
}

enum ValueType {
  percentage
  nominal
}

enum VoucherUsageType {
  product_specific
  cart_total
  shipping
}

enum VoucherSource {
  referral
  purchase_reward
  manual
}

enum PaymentMethod {
  manual_transfer
  gateway
}

// Status pembayaran terpisah dari status order — mengikuti pola status
// payment gateway (mirip Midtrans/Xendit), diadopsi dari desain Feature 3.
enum PaymentStatus {
  pending
  waiting_confirmation
  settlement
  expired
  denied
  cancelled
}

enum OrderStatus {
  waiting_payment
  waiting_confirmation
  processed
  shipped
  confirmed
  cancelled
}

// ---------------------------
// FEATURE 1 — kamu yang pegang: User, AuthToken, UserAddress, Store, ShippingMethod
// ---------------------------

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  phone          String?
  avatarUrl      String?   @map("avatar_url")
  role           Role      @default(customer)
  authProvider   AuthProvider @default(email) @map("auth_provider")
  providerId     String?   @map("provider_id")
  isVerified     Boolean   @default(false) @map("is_verified")
  verifiedAt     DateTime? @map("verified_at")
  referralCode   String    @unique @map("referral_code")

  referredById   String?   @map("referred_by_user_id")
  referredBy     User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals      User[]    @relation("UserReferrals")

  storeId        String?   @map("store_id")
  store          Store?    @relation(fields: [storeId], references: [id])

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  addresses            UserAddress[]
  authTokens           AuthToken[]
  cart                 Cart?
  orders               Order[]
  userVouchers         UserVoucher[]
  stockJournals        StockJournal[]       @relation("StockJournalCreatedBy")
  orderStatusHistories OrderStatusHistory[] @relation("OrderStatusChangedBy")

  @@map("users")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("auth_tokens")
}

model UserAddress {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String   @map("recipient_name")
  phone         String
  province      String
  city          String
  district      String
  fullAddress   String   @map("full_address")
  latitude      Float
  longitude     Float
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  orders        Order[]

  @@map("user_addresses")
}

model Store {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  latitude           Float
  longitude          Float
  address            String
  maxServiceRadiusKm Float    @map("max_service_radius_km")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  storeAdmins        User[]
  storeProducts      StoreProduct[]
  discounts          Discount[]
  orders             Order[]
  shippingMethods    ShippingMethod[]

  @@map("stores")
}

// Cache hasil quote ongkir dari RajaOngkir/sejenis, per rute (toko -> kota tujuan).
// Satu baris = satu opsi pengiriman yang ditawarkan ke user saat checkout.
model ShippingMethod {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  store           Store    @relation(fields: [storeId], references: [id])
  destinationCity String   @map("destination_city") // kota tujuan dari alamat user
  courierCode     String   @map("courier_code")      // mis. "jne"
  serviceCode     String   @map("service_code")      // mis. "REG", "YES"
  serviceName     String   @map("service_name")      // mis. "JNE Reguler"
  cost            Decimal  @db.Decimal(12, 2)
  etd             String?                             // estimasi hari, mis. "2-3"
  createdAt       DateTime @default(now()) @map("created_at")

  orders          Order[]

  @@map("shipping_methods")
}

// ---------------------------
// FEATURE 2 — punya teammate: ProductCategory, Product, ProductImage,
// StoreProduct, StockJournal, Discount, Voucher
// (kamu hanya konsumsi/read untuk landing page)
// ---------------------------

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  name        String   @unique
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  weight      Int      // dalam gram — wajib untuk kalkulasi ongkir (RajaOngkir/sejenis)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images        ProductImage[]
  storeProducts StoreProduct[]
  orderItems    OrderItem[]
  discounts     Discount[]
  vouchers      Voucher[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

// 🔗 Junction table (M:N): Store <-> Product, sekaligus tabel inventori
model StoreProduct {
  id            String   @id @default(cuid())
  storeId       String   @map("store_id")
  store         Store    @relation(fields: [storeId], references: [id])
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  stockQuantity Int      @default(0) @map("stock_quantity")
  reservedStock Int      @default(0) @map("reserved_stock") // dikunci saat checkout, sebelum pembayaran dikonfirmasi
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stockJournals StockJournal[]
  cartItems     CartItem[]

  @@unique([storeId, productId])
  @@map("store_products")
}

model StockJournal {
  id             String              @id @default(cuid())
  storeProductId String              @map("store_product_id")
  storeProduct   StoreProduct        @relation(fields: [storeProductId], references: [id])
  type           StockJournalType
  quantity       Int
  beforeStock    Int                 @map("before_stock") // snapshot stok sebelum perubahan
  afterStock     Int                 @map("after_stock")  // snapshot stok sesudah perubahan
  referenceType  StockReferenceType  @map("reference_type")
  referenceId    String?             @map("reference_id")
  notes          String?
  createdById    String?             @map("created_by")
  createdBy      User?               @relation("StockJournalCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now()) @map("created_at")

  @@map("stock_journals")
}

model Discount {
  id                 String       @id @default(cuid())
  storeId            String       @map("store_id")
  store              Store        @relation(fields: [storeId], references: [id])
  productId          String?      @map("product_id")
  product            Product?     @relation(fields: [productId], references: [id])
  type               DiscountType
  valueType          ValueType    @map("value_type")
  value              Decimal      @db.Decimal(12, 2)
  minPurchaseAmount  Decimal?     @map("min_purchase_amount") @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  startDate          DateTime     @map("start_date")
  endDate            DateTime     @map("end_date")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  vouchers           Voucher[]

  @@map("discounts")
}

model Voucher {
  id                 String            @id @default(cuid())
  discountId         String?           @map("discount_id")
  discount           Discount?         @relation(fields: [discountId], references: [id])
  code               String            @unique
  usageType          VoucherUsageType  @map("usage_type")
  valueType          ValueType         @map("value_type")
  value              Decimal           @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?          @map("max_discount_amount") @db.Decimal(12, 2)
  minPurchaseAmount  Decimal?          @map("min_purchase_amount") @db.Decimal(12, 2)
  productId          String?           @map("product_id")
  product            Product?          @relation(fields: [productId], references: [id])
  expiredAt          DateTime          @map("expired_at")
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at")

  userVouchers       UserVoucher[]

  @@map("vouchers")
}

// 🔗 Junction table (M:N): User <-> Voucher
model UserVoucher {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id])
  voucherId  String        @map("voucher_id")
  voucher    Voucher       @relation(fields: [voucherId], references: [id])
  source     VoucherSource
  isUsed     Boolean       @default(false) @map("is_used")
  usedAt     DateTime?     @map("used_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  order      Order?

  @@map("user_vouchers")
}

// ---------------------------
// FEATURE 3 — punya teammate: Cart, CartItem, Order, OrderItem, OrderStatusHistory, Payment
// (kamu tidak perlu bikin ini, dicantumkan supaya relasi lengkap & schema bisa jalan)
// v2: Payment dipisah dari Order, weight ditambahkan ke Product,
//     reserved_stock ditambahkan ke StoreProduct — hasil diskusi 3 ERD (kamu, dan 2 teman)
// ---------------------------

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items     CartItem[]

  @@map("carts")
}

// 🔗 Junction table (M:N): Cart <-> StoreProduct
model CartItem {
  id             String       @id @default(cuid())
  cartId         String       @map("cart_id")
  cart           Cart         @relation(fields: [cartId], references: [id])
  storeProductId String       @map("store_product_id")
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id])
  quantity       Int
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([cartId, storeProductId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique @map("order_number")
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id])
  storeId         String        @map("store_id")
  store           Store         @relation(fields: [storeId], references: [id])
  addressId       String        @map("address_id")
  address         UserAddress   @relation(fields: [addressId], references: [id])
  status          OrderStatus   @default(waiting_payment)
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingCost    Decimal       @map("shipping_cost") @db.Decimal(12, 2)
  shippingMethodId String       @map("shipping_method_id")
  shippingMethod  ShippingMethod @relation(fields: [shippingMethodId], references: [id])
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  userVoucherId   String?       @unique @map("user_voucher_id")
  userVoucher     UserVoucher?  @relation(fields: [userVoucherId], references: [id])
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentDeadline DateTime?     @map("payment_deadline")
  shippedAt       DateTime?     @map("shipped_at")
  confirmedAt     DateTime?     @map("confirmed_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  cancelReason    String?       @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  items           OrderItem[]
  statusHistories OrderStatusHistory[]
  payments        Payment[]

  @@map("orders")
}

// Dipisah dari Order supaya bisa menyimpan histori percobaan bayar
// (mis. bukti bayar ditolak lalu di-upload ulang) dan status granular
// dari payment gateway, tanpa mengotori status utama Order.
model Payment {
  id              String        @id @default(cuid())
  orderId         String        @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  status          PaymentStatus @default(pending)
  amount          Decimal       @db.Decimal(12, 2)
  paymentProofUrl String?       @map("payment_proof_url")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

// 🔗 Junction table (M:N): Order <-> Product
model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String  @map("order_id")
  order                Order   @relation(fields: [orderId], references: [id])
  productId            String  @map("product_id")
  product              Product @relation(fields: [productId], references: [id])
  productNameSnapshot  String  @map("product_name_snapshot")
  priceSnapshot        Decimal @map("price_snapshot") @db.Decimal(12, 2)
  quantity             Int
  subtotal             Decimal @db.Decimal(12, 2)

  @@map("order_items")
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id])
  status      OrderStatus
  changedById String?  @map("changed_by")
  changedBy   User?    @relation("OrderStatusChangedBy", fields: [changedById], references: [id])
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("order_status_histories")
}
